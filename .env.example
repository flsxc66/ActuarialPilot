# ===== LLM 配置（OpenAI 兼容协议）=====
# 任选一家填入即可。注意：真正的 .env 文件不要上传到 GitHub！
#
# --- 方案 1：智谱 GLM ---
# OPENAI_API_KEY=你的智谱key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4.6
#
# --- 方案 2：DeepSeek（便宜、中文好）---
# OPENAI_API_KEY=你的deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# --- 方案 3：OpenAI 官方 ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.6

# ===== Embedding 配置 =====
# 与 LLM 使用同一平台的 embedding 模型即可
# 智谱: embedding-3 / DeepSeek: 无 embedding 服务 / OpenAI: text-embedding-3-small

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# 选项 2: 通义千问 DashScope embedding（中文更友好）
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

EMBEDDING_PROVIDER=openai

# ===== ActuarialPilot 业务配置 =====
AP_LIFE_TABLE_DIR=./data/life_tables
AP_POLICY_DIR=./data/policies
AP_REPORT_DIR=./data/reports
AP_VECTORSTORE_DIR=./data/vectorstore
AP_LOG_LEVEL=INFO

# ===== Streamlit Secrets（部署到 Streamlit Cloud 时使用）=====
# 在 Streamlit Cloud 后台填入同名变量即可